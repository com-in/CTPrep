<Window x:Class="CtPrep.App.Views.EditionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CtPrep.App.Views"
        Title="CTPrep" Height="440" Width="560"
        MinHeight="360" MinWidth="460"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Loc Edition.Header}" Style="{StaticResource PageTitleText}" FontSize="18" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                       Text="{loc:Loc Edition.Hint}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
            <ListBox x:Name="EditionList" BorderThickness="0" Padding="6"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick"
                     KeyDown="OnListKeyDown" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Loc Edition.Cancel}" Style="{StaticResource SecondaryButton}" Click="OnCancel" MinWidth="96" />
            <Button Content="{loc:Loc Edition.Confirm}" Style="{StaticResource PrimaryButton}" Click="OnConfirm"
                    MinWidth="140" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
