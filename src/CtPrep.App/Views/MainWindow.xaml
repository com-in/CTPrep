<Window x:Class="CtPrep.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CtPrep.App.Views"
        Title="CTPrep" Height="780" Width="1040"
        MinHeight="640" MinWidth="900"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">

            <!-- 新手模式：一个动作 + 一条必须先看的风险提示 -->
            <TabItem Header="{loc:Loc Tab.Novice}">
                <Border Style="{StaticResource Card}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">

                        <TextBlock Text="{loc:Loc Novice.Title}" Style="{StaticResource PageTitleText}"
                                   HorizontalAlignment="Center" />

                        <Border Margin="0,20,0,0" Background="{StaticResource WarnBackground}"
                                BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}" Padding="14">
                            <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource WarnText}"
                                       Text="{loc:Loc Novice.Warning}" />
                        </Border>

                        <Button Content="{loc:Loc Novice.Start}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OneClickCommand}"
                                HorizontalAlignment="Center" Margin="0,24,0,0" MinWidth="220" />

                        <!-- 可选：直接用本地镜像，跳过下载 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="{loc:Loc Novice.PickImage}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding BrowseNoviceImageCommand}" />
                        </StackPanel>

                        <Border HorizontalAlignment="Center" Margin="0,10,0,0" Padding="10,6"
                                Background="{StaticResource TrackBrush}"
                                CornerRadius="{StaticResource RadiusControl}" MaxWidth="520">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HintText}" Text="{loc:Loc Novice.Selected}" />
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding NoviceImageFile}"
                                           MaxWidth="300" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding NoviceImageFile}" />
                                <Button Content="{loc:Loc Novice.Clear}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ClearNoviceImageCommand}"
                                        Padding="8,3" Margin="10,0,0,0" />
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoviceImageFile}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock Style="{StaticResource HintText}" Margin="0,18,0,0" TextAlignment="Center"
                                   Text="{Binding NoviceHint}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 高级设置：左选项、右（本机信息 + 日志 + 操作） -->
            <TabItem Header="{loc:Loc Tab.Advanced}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：选项（整列高度） -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,28,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>

                                <!-- 镜像来源 -->
                                <TextBlock Text="{loc:Loc Image.Title}" Style="{StaticResource SectionText}" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Image.Url}" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ExpertImageSource, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Image.Local}" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ExpertCustomImageFile, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Loc Image.LocalTooltip}" />
                                    <Button Grid.Column="2" Content="{loc:Loc Image.Browse}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseImageCommand}" Margin="8,0,0,0" />
                                    <Button Grid.Column="3" Content="{loc:Loc Image.Analyze}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding AnalyzeImageCommand}" Margin="8,0,0,0" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Image.Edition}" Style="{StaticResource LabelText}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ImageOptions}"
                                              SelectedItem="{Binding SelectedImage}"
                                              DisplayMemberPath="Display" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <!-- 安装方式 -->
                                <TextBlock Text="{loc:Loc Install.Title}" Style="{StaticResource SectionText}" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Install.Partition}" Style="{StaticResource LabelText}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TargetPartitionOptions}"
                                              SelectedItem="{Binding SelectedTargetPartition}"
                                              DisplayMemberPath="Display"
                                              IsEnabled="{Binding IsNotBusy}"
                                              MaxDropDownHeight="300"
                                              ToolTip="{loc:Loc Install.PartitionTooltip}" />
                                </Grid>

                                <!-- 选了非系统盘时的警示：该磁盘会被整盘重建 -->
                                <Border Margin="0,0,0,10" Padding="10,8"
                                        Background="{StaticResource WarnBackground}"
                                        BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <TextBlock Style="{StaticResource HintText}" Foreground="{StaticResource WarnText}"
                                               Text="{Binding CrossDiskHint}" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCrossDiskTarget}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <CheckBox Content="{loc:Loc Install.Clean}" IsChecked="{Binding ExpertCleanInstall}"
                                          IsEnabled="{Binding ExpertCleanInstallEnabled}" />
                                <CheckBox Content="{loc:Loc Install.Wipe}" IsChecked="{Binding ExpertWipeDisk}"
                                          IsEnabled="{Binding ExpertWipeDiskEnabled}"
                                          Foreground="{StaticResource DangerBrush}" />
                                <CheckBox Content="{loc:Loc Install.FormatBoot}" IsChecked="{Binding ExpertFormatBootPartition}"
                                          IsEnabled="{Binding ExpertFormatBootEnabled}"
                                          ToolTip="{loc:Loc Install.FormatBootTooltip}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Install.Index}" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Column="1" Text="{Binding ExpertImageIndex}"
                                             ToolTip="{loc:Loc Install.IndexTooltip}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Install.StagingSize}" Style="{StaticResource LabelText}"
                                               Margin="12,0,0,0" />
                                    <TextBox Grid.Column="3" Text="{Binding ExpertStagingSizeMB}" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <!-- 无人值守 -->
                                <TextBlock Text="{loc:Loc Unattend.Title}" Style="{StaticResource SectionText}" />
                                <CheckBox Content="{loc:Loc Unattend.Enable}" IsChecked="{Binding ExpertUnattended}" />
                                <CheckBox Content="{loc:Loc Unattend.BypassNro}" IsChecked="{Binding ExpertBypassNro}" />
                                <CheckBox Content="{loc:Loc Unattend.DisableDefender}" IsChecked="{Binding ExpertDisableDefender}"
                                          ToolTip="{loc:Loc Unattend.DisableDefenderTooltip}"
                                          Margin="0,0,0,10" />
                                <Grid Style="{StaticResource FormRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Unattend.User}" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Column="1" Text="{Binding ExpertUserName}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Unattend.Password}" Style="{StaticResource LabelText}"
                                               Margin="12,0,0,0" />
                                    <TextBox Grid.Column="3" Text="{Binding ExpertPassword}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Unattend.Computer}" Style="{StaticResource LabelText}" />
                                    <TextBox Grid.Column="1" Text="{Binding ExpertComputerName}"
                                             ToolTip="{loc:Loc Unattend.ComputerTooltip}" />
                                    <TextBlock Grid.Column="2" Text="{loc:Loc Unattend.TimeZone}" Style="{StaticResource LabelText}"
                                               Margin="12,0,0,0" />
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding TimeZoneOptions}"
                                              SelectedValue="{Binding ExpertTimeZone, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Display"
                                              MaxDropDownHeight="300"
                                              TextSearch.TextPath="Display"
                                              ToolTip="{loc:Loc Unattend.TimeZoneTooltip}" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" />

                                <!-- 驱动包 -->
                                <TextBlock Text="{loc:Loc Drivers.Title}" Style="{StaticResource SectionText}" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                           Text="{loc:Loc Drivers.Hint}" />
                                <TextBox Text="{Binding ExpertDrivers}" AcceptsReturn="True" Height="72"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" />

                                <Border Style="{StaticResource Divider}" />

                                <!-- 执行行为 -->
                                <TextBlock Text="{loc:Loc Behavior.Title}" Style="{StaticResource SectionText}" />
                                <CheckBox Content="{loc:Loc Behavior.Reboot}" IsChecked="{Binding ExpertReboot}" />
                                <CheckBox Content="{loc:Loc Behavior.Shutdown}" IsChecked="{Binding ExpertShutdown}" />
                                <CheckBox Content="{loc:Loc Behavior.DryRun}"
                                          IsChecked="{Binding ExpertDryRun}"
                                          Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LabelColumn}" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Behavior.Language}" Style="{StaticResource LabelText}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}"
                                              SelectedValue="{Binding LanguageCode}" SelectedValuePath="Code"
                                              DisplayMemberPath="Display" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 右：本机信息（上） + 日志（中） + 操作区（下） -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Loc Info.Title}" Style="{StaticResource SectionText}" Margin="0" />
                                    <Button Grid.Column="1" Content="{loc:Loc Info.Refresh}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RefreshCommand}" MinWidth="84" />
                                    <Button Grid.Column="2" Content="{loc:Loc Info.OpenDir}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenRuntimeCommand}" MinWidth="84" Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="{loc:Loc Info.System}" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SystemInfoText, Mode=OneWay}" Style="{StaticResource InfoText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{loc:Loc Info.Target}" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding TargetText, Mode=OneWay}" Style="{StaticResource InfoText}"
                                           Margin="0,0,0,10" />
                                <TextBlock Text="{loc:Loc Info.RuntimeDir}" Style="{StaticResource LabelText}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding RuntimeDir, Mode=OneWay}" Style="{StaticResource InfoText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Loc Log.Title}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                <Border Grid.Row="1" Background="{StaticResource LogBackground}"
                                        CornerRadius="{StaticResource RadiusControl}">
                                    <TextBox x:Name="LogBox" Padding="8" Text="{Binding LogText, Mode=OneWay}"
                                             IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource LogText}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 操作区：在日志下方，右对齐 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{loc:Loc Action.Cancel}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CancelCommand}" />
                            <Button Content="{loc:Loc Action.Deploy}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ExpertDeployCommand}" MinWidth="160" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态条：文案 + 重启倒计时 + 进度 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- 重启倒计时：仅在已下发 shutdown 后出现 -->
                <Border Grid.Column="1" Margin="0,0,12,0" Padding="10,6"
                        Background="{StaticResource WarnBackground}"
                        BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding RebootCountdownText}" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarnText}" VerticalAlignment="Center" />
                        <Button Content="{loc:Loc Action.CancelReboot}" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelRebootCommand}"
                                Padding="8,3" Margin="12,0,0,0" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RebootCountdownVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <ProgressBar Grid.Column="2" Height="8" Margin="16,0,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Foreground="{StaticResource Accent}" Background="{StaticResource TrackBrush}"
                             BorderThickness="0" />
            </Grid>
        </Border>
    </Grid>
</Window>
