<Window x:Class="CtPrep.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CtPrep.App.Views"
        Height="Auto" Width="540" MinHeight="260"
        SizeToContent="Height"
        Background="{StaticResource PageBackground}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource PageTitleText}"
                   FontSize="18" TextWrapping="Wrap" />

        <Border x:Name="BodyBorder" Grid.Row="1" Margin="0,14,0,0" Padding="14"
                CornerRadius="{StaticResource RadiusControl}" BorderThickness="1"
                Background="{StaticResource WarnBackground}" BorderBrush="{StaticResource WarnBorder}">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="21" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="{loc:Loc Dialog.Cancel}" Style="{StaticResource SecondaryButton}"
                    Click="OnCancel" MinWidth="100" />
            <Button x:Name="OkButton" Content="{loc:Loc Dialog.ConfirmOk}" Style="{StaticResource PrimaryButton}"
                    Click="OnOk" MinWidth="130" Margin="12,0,0,0" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
